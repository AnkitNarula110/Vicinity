# ═══════════════════════════════════════════════════════════════════════
# VICINITY BACKEND — LOCAL DEVELOPMENT
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and adjust values for your machine.
# `.env` is gitignored — never commit real secrets.

# ─── Server ────────────────────────────────────────────────────────────
# HTTP port the Axum server binds to (0.0.0.0:<PORT>).
PORT=3000

# Log verbosity: trace | debug | info | warn | error
RUST_LOG=info

# ─── Postgres ──────────────────────────────────────────────────────────
# Your local DB is on port 5435 with the "Sss1234!" password.
# If your backend uses PgBouncer in production, swap the host/port.
DATABASE_URL=postgres://postgres:Sss1234!@localhost:5435/Vicinity_DB

# ─── Redis ─────────────────────────────────────────────────────────────
# Local Redis. Start one with:
#   docker run -d --name vicinity-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────────
# HMAC secret for signing tokens. Generate with:
#   openssl rand -base64 48
# MUST be changed before deploying to production.
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Token lifetimes, in minutes (used by the auth module).
JWT_ACCESS_EXPIRY=60       # 1 hour
JWT_RESET_EXPIRY=15        # 15 minutes
JWT_REFRESH_EXPIRY=10080   # 7 days (7 * 24 * 60)

# ─── Password hashing ──────────────────────────────────────────────────
# Argon2 or bcrypt cost parameter. 10 is fine for dev; 12 for production.
PASSWORD_SALT_ROUNDS=10

# ─── BLE tunables ──────────────────────────────────────────────────────
# Server-side token TTL. 17 min = 15 min active + 2 min overlap window.
BLE_TOKEN_TTL=1020

# TTL returned to the mobile client (seconds). Always 15 min.
BLE_RETURNED_TTL=900

# RSSI gate in dBm. Anything weaker than this is ignored.
# -80 dBm ≈ 10 m in open space.
RSSI_MIN_DBM=-80

# Match score threshold (0–100). Below this, no notification is fired.
MATCH_MIN_SCORE=70

# Max match notifications per user per day.
MATCH_MAX_PER_DAY=5

# Pair cooldown after a notification: 24 hours in seconds.
PAIR_COOLDOWN_SECS=86400

# How long a user stays "present" at a venue after their last heartbeat.
VENUE_PRESENCE_TTL=300

# Location reveal window after both users confirm a meet (15 min).
MEET_LOCATION_TTL=900

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — only needed when wiring FCM push notifications
# ═══════════════════════════════════════════════════════════════════════
# Firebase Cloud Messaging HTTP v1 (service account JSON path or inline).
# Leave blank to disable push and rely on WebSocket events only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — S3 / Cloudinary for photo uploads
# ═══════════════════════════════════════════════════════════════════════
# If you store photos on S3 or Cloudinary, set these. Otherwise
# POST /users/me/photos will return a "storage not configured" error.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=